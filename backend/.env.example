# Application
APP_NAME=Knowledge Base API

# Database
DB_FILE=/app/data/docstore.db
EMBEDDINGS_DB_FILE=/app/data/embeddings.db

# CORS
# Для локальной разработки:
CORS_ORIGINS=http://localhost:3000,http://localhost:80
# Для Docker-деплоя:
# CORS_ORIGINS=http://frontend,http://localhost:3000,http://localhost:80
# Для production:
# CORS_ORIGINS=https://yourdomain.com

# ML — модель и устройство
# Варианты модели:
#   paraphrase-multilingual-mpnet-base-v2  — 768 dims, 1.5 ГБ, 50+ языков (по умолчанию)
#   paraphrase-multilingual-MiniLM-L12-v2  — 384 dims, 420 МБ, 50+ языков, быстрее
#   all-MiniLM-L6-v2                       — 384 dims, 90 МБ, только английский, самая быстрая
ML_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2
ML_DEVICE=cpu

# ML — параметры поиска и индексации
ML_CHUNK_SIZE=400   # максимальный размер одного чанка в символах
ML_TOP_K=3          # количество результатов поиска
